//! shared_wasm.wire: the text protocol of the WebAssembly module (wasm.ei).
//!
//! A WebAssembly export takes and returns a `String` (JavaScript `string`) but not yet a
//! record or a list, so a cart or a customer travels as text. The request is lines of
//! `<key> <value>`:
//!
//!     coupon SAVE10
//!     line <product_id> <unit_cents> <qty>
//!     name Ada Lovelace
//!     email ada@example.com
//!     product 1          (check_qty: the product, the wanted quantity, the stock)
//!     qty 3
//!     stock 5
//!
//! and the answer is one JSON object, written by eider-json's derived codecs from the
//! types below: `{"ok":true,...}` or
//! `{"ok":false,"errors":[{"code":2,"field":"qty","message":"..."}]}`.
//!
//! Every function here is pure and runs natively too: tests/wire_test.ei.

import std.strings
import json
import shared
import shared.money
import shared.cart
import shared.coupon
import shared.validate

/// A parsed request.
pub type Request = {
    lines: List[cart.Line]
    coupon: Option[String]
    name: String
    email: String
    product: i64
    qty: i64
    stock: i64
}

fn is(a: String, b: str) -> bool { a == String.from(b) }

fn bad(what: str) -> shared.ShopError { shared.BadInput(String.from(what)) }

fn int(s: String) -> Result[i64, shared.ShopError] {
    match strings.parse_u64(s) {
        Ok(n) => {
            if n > 9223372036854775807 { return Err(bad("number too large")) }
            Ok(n as i64)
        }
        Err(e) => Err(bad("expected a number"))
    }
}

/// Parses a request (see the module comment).
pub fn parse(src: String) -> Result[Request, shared.ShopError] {
    let mut req = Request(List.new(), None, String.from(""), String.from(""), 0, 0, 0)
    for l in strings.lines(src) {
        if l.len() > 0 {
            let (key, rest) = strings.split_once(l.copy(), " ").unwrap_or((l.copy(), String.from("")))
            if is(key, "line") {
                let f = strings.split(rest, " ")
                if f.len() != 3 { return Err(bad("line takes <product_id> <unit_cents> <qty>")) }
                let unit = money.of(int(f[1].copy())?)?
                req.lines.push(cart.Line(int(f[0].copy())?, unit, int(f[2].copy())?))
            } else if is(key, "coupon") {
                req.coupon = Some(rest)
            } else if is(key, "name") {
                req.name = rest
            } else if is(key, "email") {
                req.email = rest
            } else if is(key, "product") {
                req.product = int(rest)?
            } else if is(key, "qty") {
                req.qty = int(rest)?
            } else if is(key, "stock") {
                req.stock = int(rest)?
            } else {
                return Err(bad("unknown key"))
            }
        }
    }
    Ok(req)
}

// ---- answers: records whose derived JSON is the wire format

/// One error: `shared.code`, the field it is about, and the message people read.
pub type ErrorInfo = { code: i32, field: String, message: String }

/// `{"ok":false,"errors":[...]}`.
pub type Failure = { ok: bool, errors: List[ErrorInfo] }

/// `{"ok":true}`.
pub type Done = { ok: bool }

/// `{"ok":true,...}` with the members of `body`.
pub type Reply[T] = { ok: bool, @json(flatten) body: T }

/// `{"ok":true,"coupon":{...}}`.
pub type Found = { coupon: coupon.Info }

fn info(e: shared.ShopError) -> ErrorInfo { ErrorInfo(shared.code(e), shared.field(e), shared.message(e)) }

/// The answer for these errors.
pub fn errors(es: List[shared.ShopError]) -> String {
    let mut infos: List[ErrorInfo] = List.new()
    for e in es { infos.push(info(e)) }
    json.to_string(Failure(false, infos))
}

/// The answer for one error.
pub fn error(e: shared.ShopError) -> String {
    let mut es: List[shared.ShopError] = List.new()
    es.push(e)
    errors(es)
}

fn ok[T](body: T) -> String { json.to_string(Reply(true, body)) }

// ---- the exports' logic, over a request's text

fn with(src: String, f: fn(Request) -> String) -> String {
    match parse(src) {
        Ok(r) => f(r)
        Err(e) => error(e)
    }
}

fn quote_of(req: Request) -> String {
    let mut es: List[shared.ShopError] = List.new()
    for l in req.lines {
        match validate.qty(l.qty) {
            Err(e) => es.push(e)
            Ok(q) => {}
        }
    }
    if es.len() > 0 { return errors(es) }
    // TODO(eider-lang#143): the annotation is needed because the `None` arm alone is inferred
    let c: Option[coupon.Coupon] = match req.coupon {
        Some(code) => {
            match coupon.find(code) {
                Ok(cp) => Some(cp)
                Err(e) => { return error(e) }
            }
        }
        None => None
    }
    match cart.quote(req.lines, c) {
        Ok(q) => ok(q)
        Err(e) => error(e)
    }
}

fn customer_of(req: Request) -> String {
    match validate.customer(req.name, req.email) {
        Ok(c) => ok(c)
        Err(es) => errors(es)
    }
}

fn coupon_of(req: Request) -> String {
    match req.coupon {
        Some(code) => {
            match coupon.find(code) {
                Ok(c) => ok(Found(coupon.info(c)))
                Err(e) => error(e)
            }
        }
        None => error(bad("no coupon given"))
    }
}

fn qty_of(req: Request) -> String {
    let r = validate.qty(req.qty).and_then(|q: i64| -> Result[i64, shared.ShopError] { validate.stock(req.product, q, req.stock) })
    match r {
        Ok(q) => json.to_string(Done(true))
        Err(e) => error(e)
    }
}

/// The quote for `line` and `coupon` entries: subtotal, discount, shipping, tax, total.
pub fn quote(src: String) -> String { with(src, quote_of) }

/// The cleaned name and email of `name` and `email` entries, or every field error.
pub fn customer(src: String) -> String { with(src, customer_of) }

/// The coupon of a `coupon` entry, with its description.
pub fn find_coupon(src: String) -> String { with(src, coupon_of) }

/// Whether `qty` of `product` can be in a cart with `stock` in stock.
pub fn check_qty(src: String) -> String { with(src, qty_of) }

/// `cents` (decimal text) as money text ("$1,234.05"); "" if it is not an amount in range.
pub fn format_cents(cents: String) -> String {
    match int(cents) {
        Ok(n) => {
            match money.of(n) {
                Ok(m) => money.format(m)
                Err(e) => String.from("")
            }
        }
        Err(e) => String.from("")
    }
}
