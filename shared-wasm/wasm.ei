// wasm: the shared package as a WebAssembly module for the web front end.
//
//   cd shared-wasm && eider build --wasm wasm.ei -o ../web/src/wasm/shared   (scripts/build.sh)
//
// Two kinds of export:
//
// 1. Integer functions, called directly: `line_total_cents(1299, 2)` and the shop's
//    constants. A negative result from line_total_cents is minus an error code
//    (shared.code).
// 2. Text functions, `String -> String` (a JavaScript string each way; the generated loader
//    copies them in and out of the module's memory): `quote`, `check_customer`,
//    `find_coupon`, `check_qty` and `format_cents` take a request of `<key> <value>` lines
//    and answer JSON (shared_wasm.wire has the format, the answers and the logic, and is
//    tested natively). web/src/shop.ts wraps all of this in typed functions.
//
// Records and lists can't cross the boundary yet, which is why the request is text and the
// answer JSON.
//
// The module needs no capability: no host imports, no output channel. It stays a package
// of its own so that the server, which depends on `shared` alone, doesn't build the wire
// format.

import shared
import shared.money
import shared.cart
import shared.validate
import shared_wasm.wire

// ---- integer functions

/// unit * qty in cents, or minus the error code (1: too large, 2: bad quantity).
export fn line_total_cents(unit_cents: i64, qty: i64) -> i64 {
    match validate.qty(qty) {
        Err(e) => { return 0 - shared.code(e) as i64 }
        Ok(q) => {}
    }
    match money.of(unit_cents) {
        Ok(u) => {
            match cart.line_total(cart.Line(0, u, qty)) {
                Ok(t) => t.cents
                Err(e) => 0 - shared.code(e) as i64
            }
        }
        Err(e) => 0 - shared.code(shared.AmountTooLarge) as i64
    }
}

export fn max_qty() -> i64 { validate.MAX_QTY }
export fn max_lines() -> i64 { validate.MAX_LINES }
export fn tax_bp() -> i64 { cart.TAX_BP }
export fn shipping_cents() -> i64 { cart.SHIPPING_CENTS }
export fn free_shipping_from_cents() -> i64 { cart.FREE_SHIPPING_FROM }
export fn max_cents() -> i64 { money.MAX_CENTS }

// ---- text functions: a request in, JSON out

/// The quote for `line` and `coupon` entries: subtotal, discount, shipping, tax, total.
export fn quote(request: String) -> String { wire.quote(request) }

/// The cleaned name and email of `name` and `email` entries, or every field error.
export fn check_customer(request: String) -> String { wire.customer(request) }

/// The coupon of a `coupon` entry, with its description.
export fn find_coupon(request: String) -> String { wire.find_coupon(request) }

/// Whether `qty` of `product` fits a cart with `stock` in stock: `{"ok":true}` or the error.
export fn check_qty(request: String) -> String { wire.check_qty(request) }

/// `cents` (decimal text) as money text ("$1,234.05"); "" if it is out of range.
export fn format_cents(cents: String) -> String { wire.format_cents(cents) }
