// wire: the WebAssembly module's request parser and JSON answers, tested natively.
import std.testing
import shared_wasm.wire


test "quote" {
    testing.assert_eq(wire.quote(String.from("line 1 1299 2\nline 2 450 1\n")), String.from("{{\"ok\":true,\"subtotal_cents\":3048,\"discount_cents\":0,\"shipping_cents\":599,\"tax_cents\":251,\"total_cents\":3898,\"coupon_applied\":false}}"))
    testing.assert_eq(wire.quote(String.from("coupon save10\nline 1 5000 1")), String.from("{{\"ok\":true,\"subtotal_cents\":5000,\"discount_cents\":500,\"shipping_cents\":599,\"tax_cents\":371,\"total_cents\":5470,\"coupon_applied\":true}}"))
}

test "quote errors" {
    testing.assert_eq(wire.quote(String.from("line 1 1299 0\nline 2 1 11")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":2,\"field\":\"qty\",\"message\":\"the quantity must be 1 to 10\"}},{{\"code\":2,\"field\":\"qty\",\"message\":\"the quantity must be 1 to 10\"}}]}}"))
    testing.assert_eq(wire.quote(String.from("coupon \"x\nline 1 1 1")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":6,\"field\":\"code\",\"message\":\"there is no coupon \\\"X\"}}]}}"))
    testing.assert_eq(wire.quote(String.from("line 1 x 1")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":12,\"field\":\"\",\"message\":\"bad input: expected a number\"}}]}}"))
    testing.assert_eq(wire.quote(String.from("line 1 99999999999999999 1")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":1,\"field\":\"\",\"message\":\"the amount is too large\"}}]}}"))
    testing.assert_eq(wire.quote(String.from("colour red")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":12,\"field\":\"\",\"message\":\"bad input: unknown key\"}}]}}"))
}

test "customer" {
    testing.assert_eq(wire.customer(String.from("name  Ada \nemail ADA@Example.com")), String.from("{{\"ok\":true,\"name\":\"Ada\",\"email\":\"ADA@example.com\"}}"))
    testing.assert_eq(wire.customer(String.from("name \nemail x")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":9,\"field\":\"name\",\"message\":\"the name must be 1 to 80 characters\"}},{{\"code\":10,\"field\":\"email\",\"message\":\"the email address is not valid\"}}]}}"))
}

test "coupon lookup" {
    testing.assert_eq(wire.find_coupon(String.from("coupon take5")), String.from("{{\"ok\":true,\"coupon\":{{\"id\":2,\"code\":\"TAKE5\",\"description\":\"$5.00 off orders of $25.00 or more\",\"min_cents\":2500}}}}"))
}

test "check qty" {
    testing.assert_eq(wire.check_qty(String.from("product 1\nqty 3\nstock 5")), String.from("{{\"ok\":true}}"))
    testing.assert_eq(wire.check_qty(String.from("product 7\nqty 6\nstock 5")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":3,\"field\":\"qty\",\"message\":\"only 5 of product 7 in stock (wanted 6)\"}}]}}"))
    testing.assert_eq(wire.check_qty(String.from("product 1\nqty 0\nstock 5")), String.from("{{\"ok\":false,\"errors\":[{{\"code\":2,\"field\":\"qty\",\"message\":\"the quantity must be 1 to 10\"}}]}}"))
}

test "format cents" {
    testing.assert_eq(wire.format_cents(String.from("123405")), String.from("$1,234.05"))
    testing.assert_eq(wire.format_cents(String.from("99999999999999999")), String.from(""))
}
