//! server/api: the shop's REST API, described with eider-openapi.
//!
//!   GET    /api/products                          the catalog
//!   GET    /api/products/{id}                     one product                 -> 200 / 404
//!   GET    /api/coupons                           the coupons (from shared/coupon)
//!   POST   /api/carts                             a new, empty cart           -> 201 Cart
//!   GET    /api/carts/{id}                        a cart, priced by shared/cart
//!   POST   /api/carts/{id}/lines                  add a product (AddLine)     -> 200 Cart / 404 / 409 / 422
//!   PUT    /api/carts/{id}/lines/{product_id}     set a quantity (0 removes)  -> 200 Cart
//!   DELETE /api/carts/{id}/lines/{product_id}     remove a product            -> 200 Cart
//!   PUT    /api/carts/{id}/coupon                 apply a coupon (CouponCode) -> 200 Cart / 422
//!   DELETE /api/carts/{id}/coupon                 remove the coupon           -> 200 Cart
//!   POST   /api/carts/{id}/checkout               buy (Checkout)              -> 201 Order / 409 / 422
//!   GET    /api/orders?email=                     orders, newest first
//!   GET    /api/orders/{id}                       one order                   -> 200 / 404
//!   GET    /openapi.json                          this description
//!
//! Every route is registered with its operation, so the router pattern, the request
//! validation (400 problem+json listing every wrong field, 413, 415) and the served document
//! come from one value. The bounds in the schemas are the shared package's constants
//! (validate.MAX_QTY, money.MAX_CENTS, ...), so the description states the same rules the
//! code enforces. Errors are RFC 9457 problem+json throughout.

import std.bytes
import http
import http.problem
import http.middleware
import openapi
import openapi.schema
import shared
import shared.money
import shared.cart
import shared.coupon
import shared.validate
import server.store

fn lit(s: str) -> List[u8] { String.from(s).bytes() }

// ---- errors

fn shop_problem(e: shared.ShopError) -> problem.ApiError {
    let mut p = problem.with_detail(shared.status(e), shared.message(e).bytes())
    let f = shared.field(e)
    if f.len() > 0 {
        let mut ptr = String.from("#/")
        ptr.append(f)
        p = p.field("body", ptr.bytes(), shared.message(e).bytes())
    }
    p
}

/// A store error as problem+json: the shared rule's status and message, a field error
/// naming the member it is about.
pub fn to_problem(e: store.StoreError) -> problem.ApiError {
    match e {
        store.Rule(r) => shop_problem(r)
        store.Invalid(es) => {
            let mut p = problem.with_detail(422, store.message(store.Invalid(es.copy())).bytes())
            for r in es {
                let mut ptr = String.from("#/")
                ptr.append(shared.field(r))
                p = p.field("body", ptr.bytes(), shared.message(r).bytes())
            }
            p
        }
        store.NoCart(id) => problem.with_detail(404, store.message(e).bytes())
        store.NoOrder(id) => problem.with_detail(404, store.message(e).bytes())
    }
}

fn lift[T](r: Result[T, store.StoreError]) -> Result[T, problem.ApiError] {
    match r {
        Ok(v) => Ok(v)
        Err(e) => Err(to_problem(e))
    }
}

// TODO(eider-openapi#3): Input.text gives a String
fn text(b: List[u8]) -> Result[String, problem.ApiError] {
    String.from_bytes(b).map_err(|i: usize| -> problem.ApiError { problem.bad_request("text must be UTF-8 without NUL") })
}

// ---- schemas (TODO(eider-openapi#1): derived from the types with JSON derive and reflection)

fn cents(desc: str) -> schema.Schema { schema.integer().format("int64").min(0).max(money.MAX_CENTS).describe(desc) }

fn id_schema() -> schema.Schema { schema.integer().format("int64").min(1) }

fn product_schema() -> schema.Schema {
    let mut s = schema.object().describe("A product in the catalog").closed()
    s = s.field("id", id_schema())
    s = s.field("sku", schema.string().min_length(1).max_length(32))
    s = s.field("name", schema.string().min_length(1).max_length(100))
    s = s.field("description", schema.string().max_length(1000))
    s = s.field("price_cents", cents("Unit price in cents (USD)"))
    s.field("stock", schema.integer().min(0).describe("Units in stock"))
}

fn quote_schema() -> schema.Schema {
    let mut s = schema.object().describe("What a cart costs, computed by the shared package (shared/cart.ei)").closed()
    s = s.field("subtotal_cents", cents("Sum of the lines"))
    s = s.field("discount_cents", cents("Taken off by the coupon"))
    s = s.field("shipping_cents", cents("Free from $50.00 after discounts, else $5.99"))
    s = s.field("tax_cents", cents("8.25% of the subtotal after discounts"))
    s = s.field("total_cents", cents("What the order costs"))
    s.field("coupon_applied", schema.boolean().describe("False when the cart's coupon needs a larger subtotal"))
}

fn line_schema() -> schema.Schema {
    let mut s = schema.object().describe("A cart line with its product's current price and stock").closed()
    s = s.field("product_id", id_schema())
    s = s.field("name", schema.string())
    s = s.field("unit_cents", cents("Unit price in cents"))
    s = s.field("qty", schema.integer().min(1).max(validate.MAX_QTY))
    s = s.field("line_total_cents", cents("unit_cents * qty"))
    s.field("stock", schema.integer().min(0))
}

fn code_schema() -> schema.Schema { schema.string().min_length(1).max_length(32) }

fn cart_schema(line: schema.Schema, quote: schema.Schema) -> schema.Schema {
    let mut s = schema.object().describe("A shopping cart").closed()
    s = s.field("id", id_schema())
    s = s.field("lines", schema.array(line).max_length(validate.MAX_LINES))
    s = s.field("coupon", code_schema().nullable())
    s.field("quote", quote)
}

fn order_line_schema() -> schema.Schema {
    let mut s = schema.object().describe("A line of an order, at the price paid").closed()
    s = s.field("product_id", id_schema())
    s = s.field("name", schema.string())
    s = s.field("unit_cents", cents("Unit price paid"))
    s = s.field("qty", schema.integer().min(1).max(validate.MAX_QTY))
    s.field("line_total_cents", cents("unit_cents * qty"))
}

fn name_schema() -> schema.Schema { schema.string().min_length(1).max_length(validate.MAX_NAME as i64) }

fn email_schema() -> schema.Schema { schema.string().format("email").min_length(3).max_length(validate.MAX_EMAIL as i64) }

fn order_schema(line: schema.Schema, quote: schema.Schema) -> schema.Schema {
    let mut s = schema.object().describe("A placed order").closed()
    s = s.field("id", id_schema())
    s = s.field("lines", schema.array(line))
    s = s.field("coupon", code_schema().nullable())
    s = s.field("quote", quote)
    s = s.field("name", name_schema())
    s = s.field("email", email_schema())
    s.field("created_at", schema.string().format("date-time"))
}

fn coupon_schema() -> schema.Schema {
    let mut s = schema.object().describe("A coupon (shared/coupon.ei)").closed()
    s = s.field("id", schema.integer().min(1))
    s = s.field("code", code_schema())
    s = s.field("description", schema.string())
    s.field("min_cents", cents("The subtotal it needs"))
}

fn add_line_schema() -> schema.Schema {
    let mut s = schema.object().describe("A product to add to the cart").closed()
    s = s.field("product_id", id_schema())
    s.field("qty", schema.integer().min(1).max(validate.MAX_QTY))
}

fn set_qty_schema() -> schema.Schema {
    let s = schema.object().describe("The new quantity; 0 removes the line").closed()
    s.field("qty", schema.integer().min(0).max(validate.MAX_QTY))
}

fn coupon_code_schema() -> schema.Schema {
    let s = schema.object().describe("A coupon code (case and surrounding spaces don't matter)").closed()
    s.field("code", code_schema())
}

fn checkout_schema() -> schema.Schema {
    let mut s = schema.object().describe("Who is buying").closed()
    s = s.field("name", name_schema())
    s.field("email", email_schema())
}

// ---- encoders (TODO(eider-json#1): JSON derive writes these)

fn opt_text(v: Option[String]) -> Option[List[u8]] {
    match v {
        Some(s) => Some(s.bytes())
        None => None
    }
}

pub fn product_json(p: store.Product) -> List[u8] {
    openapi.obj().int("id", p.id).str("sku", p.sku.bytes()).str("name", p.name.bytes()).str("description", p.description.bytes()).int("price_cents", p.price.cents).int("stock", p.stock).done()
}

fn products_json(ps: List[store.Product]) -> List[u8] {
    let mut items: List[List[u8]] = List.new()
    for p in ps { items.push(product_json(p)) }
    openapi.arr(items)
}

pub fn quote_json(q: cart.Quote) -> List[u8] {
    let mut o = openapi.obj().int("subtotal_cents", q.subtotal.cents).int("discount_cents", q.discount.cents)
    o = o.int("shipping_cents", q.shipping.cents).int("tax_cents", q.tax.cents).int("total_cents", q.total.cents)
    o.bool("coupon_applied", q.coupon_applied).done()
}

pub fn cart_json(c: store.CartView) -> List[u8] {
    let mut lines: List[List[u8]] = List.new()
    for l in c.lines {
        let mut o = openapi.obj().int("product_id", l.product_id).str("name", l.name.bytes()).int("unit_cents", l.unit.cents)
        lines.push(o.int("qty", l.qty).int("line_total_cents", l.line_total.cents).int("stock", l.stock).done())
    }
    openapi.obj().int("id", c.id).raw("lines", openapi.arr(lines)).opt_str("coupon", opt_text(c.coupon.copy())).raw("quote", quote_json(c.quote)).done()
}

pub fn order_json(o: store.Order) -> List[u8] {
    let mut lines: List[List[u8]] = List.new()
    for l in o.lines {
        let ob = openapi.obj().int("product_id", l.product_id).str("name", l.name.bytes()).int("unit_cents", l.unit.cents)
        lines.push(ob.int("qty", l.qty).int("line_total_cents", l.line_total.cents).done())
    }
    let mut b = openapi.obj().int("id", o.id).raw("lines", openapi.arr(lines)).opt_str("coupon", opt_text(o.coupon.copy()))
    b = b.raw("quote", quote_json(o.quote)).str("name", o.customer.name.bytes()).str("email", o.customer.email.bytes())
    b.str("created_at", middleware.rfc3339(o.created_ns)).done()
}

fn orders_json(os: List[store.Order]) -> List[u8] {
    let mut items: List[List[u8]] = List.new()
    for o in os { items.push(order_json(o)) }
    openapi.arr(items)
}

fn coupons_json(cs: List[coupon.Coupon]) -> List[u8] {
    let mut items: List[List[u8]] = List.new()
    for c in cs {
        items.push(openapi.obj().int("id", c.id as i64).str("code", c.code.bytes()).str("description", coupon.describe(c).bytes()).int("min_cents", c.min_cents).done())
    }
    openapi.arr(items)
}

// ---- decoders (TODO(eider-json#1): JSON derive reads these)

type LineArgs = { cart: i64, product: i64, qty: i64 }

type Buyer = { cart: i64, name: String, email: String }

fn decode_id(i: openapi.Input) -> Result[i64, problem.ApiError] { i.path_int("id") }

fn decode_add(i: openapi.Input) -> Result[LineArgs, problem.ApiError] {
    Ok(LineArgs(i.path_int("id")?, i.int("product_id")?, i.int("qty")?))
}

fn decode_set(i: openapi.Input) -> Result[LineArgs, problem.ApiError] {
    Ok(LineArgs(i.path_int("id")?, i.path_int("product_id")?, i.int("qty")?))
}

fn decode_remove(i: openapi.Input) -> Result[LineArgs, problem.ApiError] {
    Ok(LineArgs(i.path_int("id")?, i.path_int("product_id")?, 0))
}

fn decode_coupon(i: openapi.Input) -> Result[(i64, String), problem.ApiError] {
    Ok((i.path_int("id")?, text(i.str("code")?)?))
}

fn decode_buyer(i: openapi.Input) -> Result[Buyer, problem.ApiError] {
    Ok(Buyer(i.path_int("id")?, text(i.str("name")?)?, text(i.str("email")?)?))
}

fn decode_email(i: openapi.Input) -> Result[Option[String], problem.ApiError] {
    match i.query("email") {
        Some(e) => Ok(Some(text(e)?))
        None => Ok(None)
    }
}

/// The described API over `s`. `now_ns` is the wall clock (orders' created_at), passed in so
/// tests can fix it.
pub fn service(s: store.Store, now_ns: fn() -> i64) -> openapi.Service {
    let mut svc = openapi.service("Eider Shop API", "0.1.0")
    svc.describe("An example shop: a catalog, carts priced by Eider code shared with the web page as WebAssembly, checkout and orders.")
    let quote = svc.component("Quote", quote_schema())
    let product = svc.component("Product", product_schema())
    // TODO(eider-lang#145): one expression once an argument may use the receiver
    let cart_line = svc.component("CartLine", line_schema())
    let cart_ref = svc.component("Cart", cart_schema(cart_line, quote))
    let order_line = svc.component("OrderLine", order_line_schema())
    let order = svc.component("Order", order_schema(order_line, quote))
    let coupon_ref = svc.component("Coupon", coupon_schema())
    let id = id_schema()

    // TODO(eider-lang#146): builders continue on the next line once a method chain may
    // (eider-openapi gap O1); until then they are reassignments
    let mut list = openapi.op("GET", "/api/products").operation_id("listProducts").summary("List the catalog").tag("catalog")
    list = list.returns(200, "Every product, by id", schema.array(product))
    svc.add(list, openapi.typed(openapi.no_input, |u: bool| -> Result[List[store.Product], problem.ApiError] { Ok(s.products()) }, products_json))

    let mut get = openapi.op("GET", "/api/products/{id}").operation_id("getProduct").summary("Get a product").tag("catalog")
    get = get.path_param("id", id).returns(200, "The product", product).fails(404, "No such product")
    svc.add(get, openapi.typed(decode_id, |n: i64| -> Result[store.Product, problem.ApiError] { lift(s.product(n)) }, product_json))

    let mut coupons = openapi.op("GET", "/api/coupons").operation_id("listCoupons").summary("List the coupons").tag("catalog")
    coupons = coupons.returns(200, "Every coupon", schema.array(coupon_ref))
    svc.add(coupons, openapi.typed(openapi.no_input, |u: bool| -> Result[List[coupon.Coupon], problem.ApiError] { Ok(coupon.all()) }, coupons_json))

    let mut create = openapi.op("POST", "/api/carts").operation_id("createCart").summary("Create an empty cart").tag("cart")
    create = create.returns(201, "The new cart", cart_ref)
    svc.add(create, openapi.typed(openapi.no_input, |u: bool| -> Result[store.CartView, problem.ApiError] { Ok(s.new_cart()) }, cart_json))

    let mut view = openapi.op("GET", "/api/carts/{id}").operation_id("getCart").summary("Get a cart with its totals").tag("cart")
    view = view.path_param("id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart")
    svc.add(view, openapi.typed(decode_id, |n: i64| -> Result[store.CartView, problem.ApiError] { lift(s.cart(n)) }, cart_json))

    let mut add = openapi.op("POST", "/api/carts/{id}/lines").operation_id("addLine").summary("Add a product to a cart").tag("cart")
    add = add.path_param("id", id).max_body(1024).body(add_line_schema(), "The product and how many")
    add = add.returns(200, "The cart", cart_ref).fails(404, "No such cart or product").fails(409, "Not enough stock").fails(422, "Too many of it, or too many products")
    svc.add(add, openapi.typed(decode_add, |a: LineArgs| -> Result[store.CartView, problem.ApiError] { lift(s.add_line(a.cart, a.product, a.qty)) }, cart_json))

    let mut set = openapi.op("PUT", "/api/carts/{id}/lines/{product_id}").operation_id("setLine").summary("Set a line's quantity (0 removes it)").tag("cart")
    set = set.path_param("id", id).path_param("product_id", id).max_body(1024).body(set_qty_schema(), "The quantity")
    set = set.returns(200, "The cart", cart_ref).fails(404, "No such cart or product").fails(409, "Not enough stock").fails(422, "Too many products")
    svc.add(set, openapi.typed(decode_set, |a: LineArgs| -> Result[store.CartView, problem.ApiError] { lift(s.set_line(a.cart, a.product, a.qty)) }, cart_json))

    let mut rm = openapi.op("DELETE", "/api/carts/{id}/lines/{product_id}").operation_id("removeLine").summary("Remove a product from a cart").tag("cart")
    rm = rm.path_param("id", id).path_param("product_id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart, or the product is not in it")
    svc.add(rm, openapi.typed(decode_remove, |a: LineArgs| -> Result[store.CartView, problem.ApiError] { lift(s.remove_line(a.cart, a.product)) }, cart_json))

    let mut cp = openapi.op("PUT", "/api/carts/{id}/coupon").operation_id("applyCoupon").summary("Apply a coupon").tag("cart")
    cp = cp.path_param("id", id).max_body(1024).body(coupon_code_schema(), "The code")
    cp = cp.returns(200, "The cart", cart_ref).fails(404, "No such cart").fails(422, "No such coupon, or the subtotal is below its minimum")
    svc.add(cp, openapi.typed(decode_coupon, |a: (i64, String)| -> Result[store.CartView, problem.ApiError] {
        let (n, code) = a
        lift(s.set_coupon(n, code))
    }, cart_json))

    let mut uncp = openapi.op("DELETE", "/api/carts/{id}/coupon").operation_id("removeCoupon").summary("Remove the coupon").tag("cart")
    uncp = uncp.path_param("id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart")
    svc.add(uncp, openapi.typed(decode_id, |n: i64| -> Result[store.CartView, problem.ApiError] { lift(s.clear_coupon(n)) }, cart_json))

    let mut buy = openapi.op("POST", "/api/carts/{id}/checkout").operation_id("checkout").summary("Buy a cart").tag("orders")
    buy = buy.describe("Checks the stock of every line, prices the cart with the shared rules, takes the stock and records the order in one critical section; the cart is deleted.")
    buy = buy.path_param("id", id).max_body(2048).body(checkout_schema(), "Who is buying")
    buy = buy.returns(201, "The order", order).fails(404, "No such cart").fails(409, "Not enough stock").fails(422, "The cart is empty, or the name or email is not valid")
    svc.add(buy, openapi.typed(decode_buyer, |b: Buyer| -> Result[store.Order, problem.ApiError] { lift(s.checkout(b.cart, b.name, b.email, now_ns())) }, order_json))

    let mut orders = openapi.op("GET", "/api/orders").operation_id("listOrders").summary("List orders, newest first").tag("orders")
    orders = orders.query("email", email_schema(), "Only this customer's orders")
    orders = orders.returns(200, "The orders", schema.array(order))
    svc.add(orders, openapi.typed(decode_email, |e: Option[String]| -> Result[List[store.Order], problem.ApiError] { Ok(s.orders(e)) }, orders_json))

    let mut one = openapi.op("GET", "/api/orders/{id}").operation_id("getOrder").summary("Get an order").tag("orders")
    one = one.path_param("id", id).returns(200, "The order", order).fails(404, "No such order")
    svc.add(one, openapi.typed(decode_id, |n: i64| -> Result[store.Order, problem.ApiError] { lift(s.order(n)) }, order_json))

    svc.raw("GET", "/health", |q: http.Request| -> http.Response { http.text(200, "ok") })
    svc
}
