//! server/api: the shop's REST API, described with eider-openapi.
//!
//!   GET    /api/products                          the catalog
//!   GET    /api/products/{id}                     one product                 -> 200 / 404
//!   GET    /api/coupons                           the coupons (from shared/coupon)
//!   POST   /api/carts                             a new, empty cart           -> 201 Cart
//!   GET    /api/carts/{id}                        a cart, priced by shared/cart
//!   POST   /api/carts/{id}/lines                  add a product (AddLine)     -> 200 Cart / 404 / 409 / 422
//!   PUT    /api/carts/{id}/lines/{product_id}     set a quantity (0 removes)  -> 200 Cart
//!   DELETE /api/carts/{id}/lines/{product_id}     remove a product            -> 200 Cart
//!   PUT    /api/carts/{id}/coupon                 apply a coupon (CouponCode) -> 200 Cart / 422
//!   DELETE /api/carts/{id}/coupon                 remove the coupon           -> 200 Cart
//!   POST   /api/carts/{id}/checkout               buy (Checkout)              -> 201 Order / 409 / 422
//!   GET    /api/orders?email=                     orders, newest first
//!   GET    /api/orders/{id}                       one order                   -> 200 / 404
//!   GET    /openapi.json                          this description
//!
//! Every route is registered with its operation, so the router pattern, the request
//! validation (400 problem+json listing every wrong field, 413, 415) and the served document
//! come from one value. The bounds in the schemas are the shared package's constants
//! (validate.MAX_QTY, money.MAX_CENTS, ...), so the description states the same rules the
//! code enforces. Errors are RFC 9457 problem+json throughout.

import std.serial
import std.time
import json
import http
import http.problem
import openapi
import openapi.derive
import openapi.schema
import shared
import shared.money
import shared.cart
import shared.coupon
import shared.validate
import server.store

// ---- errors

fn shop_problem(e: shared.ShopError) -> problem.ApiError {
    let mut p = problem.with_detail(shared.status(e), shared.message(e).bytes())
    let f = shared.field(e)
    if f.len() > 0 {
        let ptr = "#/{f}"
        p = p.field("body", ptr.bytes(), shared.message(e).bytes())
    }
    p
}

/// A store error as problem+json: the shared rule's status and message, a field error
/// naming the member it is about.
pub fn to_problem(e: store.StoreError) -> problem.ApiError {
    match e {
        store.Rule(r) => shop_problem(r)
        store.Invalid(es) => {
            let mut p = problem.with_detail(422, store.message(store.Invalid(es.copy())).bytes())
            for r in es {
                let f = shared.field(r)
                let ptr = "#/{f}"
                p = p.field("body", ptr.bytes(), shared.message(r).bytes())
            }
            p
        }
        store.NoCart { .. } | store.NoOrder { .. } => problem.with_detail(404, store.message(e).bytes())
    }
}

fn lift[T](r: Result[T, store.StoreError]) -> Result[T, problem.ApiError] {
    match r {
        Ok(v) => Ok(v)
        Err(e) => Err(to_problem(e))
    }
}

// ---- the bodies: records with derived JSON codecs (eider-json) and schemas (eider-openapi)

/// Money is a bare number of cents in JSON (shared/money.ei), 0 to money.MAX_CENTS.
impl derive.Schematic for money.Money {
    fn json_schema() -> schema.Schema { schema.integer().format("int64").min(0).max(money.MAX_CENTS) }
    fn sample() -> money.Money { money.zero() }
}

/// The schemas of the records the API shows, from their fields (`@[derive(Schematic)]` would
/// need the shared package to depend on eider-openapi, so they are implemented here).
impl derive.Schematic for cart.Quote {}
impl derive.Schematic for coupon.Info {}
impl derive.Schematic for validate.Customer {}
impl derive.Schematic for store.Product {}
impl derive.Schematic for store.ViewLine {}
impl derive.Schematic for store.CartView {}
impl derive.Schematic for store.OrderLine {}
impl derive.Schematic for store.Order {}

/// Request bodies, as the API's JSON members. The rules are `@[check]` on the fields: the
/// decoder enforces them, `json_schema()` states them, and the 400 names the field. The
/// checkout body is `validate.Customer`, the record the shared package checks at checkout.
@[derive(Serialize, Deserialize, Schematic)]
type AddIn = {
    @[check(min = 1)] product_id: i64
    @[check(min = 1, max = validate.MAX_QTY)] qty: i64
}

@[derive(Serialize, Deserialize, Schematic)]
type QtyIn = { @[check(min = 0, max = validate.MAX_QTY)] qty: i64 }

@[derive(Serialize, Deserialize, Schematic)]
type CodeIn = { @[check(min_len = 1, max_len = 32)] code: String }

/// An order as the API shows it: the order's members and when it was placed (RFC 3339).
@[derive(Serialize, Schematic)]
type OrderBody = { @[json(flatten)] order: store.Order, created_at: String }

fn order_body(o: store.Order) -> OrderBody {
    let at = time.timestamp(o.created_ns / 1000000000, o.created_ns % 1000000000).rfc3339()
    OrderBody(o, at)
}

fn order_bodies(os: List[store.Order]) -> List[OrderBody] {
    let mut bodies: List[OrderBody] = List.new()
    for o in os { bodies.push(order_body(o)) }
    bodies
}

fn coupon_infos(cs: List[coupon.Coupon]) -> List[coupon.Info] {
    let mut infos: List[coupon.Info] = List.new()
    for c in cs { infos.push(coupon.info(c)) }
    infos
}

// ---- schemas: the structure and the bounds of every record come from the types
// (`T.json_schema()` reads the fields' `@[check]`); written by hand are the path and query
// parameters, which are not fields, the descriptions, and the references to components

/// `s` with its property `name` replaced by `p`.
fn with(s: schema.Schema, name: str, p: schema.Schema) -> schema.Schema {
    let key = String.from(name).bytes()
    let mut out = s.copy()
    for i in 0..out.props.len() {
        if out.props[i].name == key { out.props[i] = schema.Prop(key.copy(), p.copy()) }
    }
    out
}

fn id_schema() -> schema.Schema { schema.integer().format("int64").min(1) }

fn email_schema() -> schema.Schema { schema.string().format("email").min_length(3).max_length(validate.MAX_EMAIL) }

fn product_schema() -> schema.Schema { store.Product.json_schema().describe("A product in the catalog") }

fn line_schema() -> schema.Schema { store.ViewLine.json_schema().describe("A cart line with its product's current price and stock") }

fn cart_schema(line: schema.Schema, quote: schema.Schema) -> schema.Schema {
    let s = store.CartView.json_schema().describe("A shopping cart")
    with(with(s, "lines", schema.array(line).max_length(validate.MAX_LINES)), "quote", quote)
}

fn order_line_schema() -> schema.Schema { store.OrderLine.json_schema().describe("A line of an order, at the price paid") }

fn order_schema(line: schema.Schema, quote: schema.Schema) -> schema.Schema {
    let s = OrderBody.json_schema().describe("A placed order")
    with(with(with(s, "lines", schema.array(line)), "quote", quote), "created_at", schema.string().format("date-time"))
}

/// The described API over `s`. `now_ns` is the wall clock (orders' created_at), passed in so
/// tests can fix it.
pub fn service(s: store.Store, now_ns: fn() -> i64) -> openapi.Service {
    let mut svc = openapi.service("Eider Shop API", "0.5.0")
    svc.describe("An example shop: a catalog, carts priced by Eider code shared with the web page as WebAssembly, checkout and orders.")
    let quote = svc.component("Quote", cart.Quote.json_schema().describe("What a cart costs, computed by the shared package (shared/cart.ei)"))
    let product = svc.component("Product", product_schema())
    // TODO(eider-lang#145): one expression once an argument may use the receiver
    let cart_line = svc.component("CartLine", line_schema())
    let cart_ref = svc.component("Cart", cart_schema(cart_line, quote))
    let order_line = svc.component("OrderLine", order_line_schema())
    let order = svc.component("Order", order_schema(order_line, quote))
    let coupon_ref = svc.component("Coupon", coupon.Info.json_schema().describe("A coupon (shared/coupon.ei)"))
    let id = id_schema()

    // A method chain doesn't continue on the next line (eider-lang#146, closed as not
    // planned; eider-openapi gap O1), so the builders are reassignments
    let mut list = openapi.op("GET", "/api/products").operation_id("listProducts").summary("List the catalog").tag("catalog")
    list = list.returns(200, "Every product, by id", schema.array(product))
    svc.add(list, openapi.json_out(|i: openapi.Input| -> Result[List[store.Product], problem.ApiError] { Ok(s.products()) }))

    let mut get = openapi.op("GET", r"/api/products/{id}").operation_id("getProduct").summary("Get a product").tag("catalog")
    get = get.path_param("id", id).returns(200, "The product", product).fails(404, "No such product")
    svc.add(get, openapi.json_out(|i: openapi.Input| -> Result[store.Product, problem.ApiError] { lift(s.product(i.path_int("id")?)) }))

    let mut coupons = openapi.op("GET", "/api/coupons").operation_id("listCoupons").summary("List the coupons").tag("catalog")
    coupons = coupons.returns(200, "Every coupon", schema.array(coupon_ref))
    svc.add(coupons, openapi.json_out(|i: openapi.Input| -> Result[List[coupon.Info], problem.ApiError] { Ok(coupon_infos(coupon.all())) }))

    let mut create = openapi.op("POST", "/api/carts").operation_id("createCart").summary("Create an empty cart").tag("cart")
    create = create.returns(201, "The new cart", cart_ref)
    svc.add(create, openapi.json_out(|i: openapi.Input| -> Result[store.CartView, problem.ApiError] { Ok(s.new_cart()) }))

    let mut view = openapi.op("GET", r"/api/carts/{id}").operation_id("getCart").summary("Get a cart with its totals").tag("cart")
    view = view.path_param("id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart")
    svc.add(view, openapi.json_out(|i: openapi.Input| -> Result[store.CartView, problem.ApiError] { lift(s.cart(i.path_int("id")?)) }))

    let mut add = openapi.op("POST", r"/api/carts/{id}/lines").operation_id("addLine").summary("Add a product to a cart").tag("cart")
    add = add.path_param("id", id).max_body(1024).body(AddIn.json_schema().describe("A product to add to the cart"), "The product and how many")
    add = add.returns(200, "The cart", cart_ref).fails(404, "No such cart or product").fails(409, "Not enough stock").fails(422, "Too many of it, or too many products")
    svc.add(add, openapi.json_body_with(|i: openapi.Input, b: AddIn| -> Result[store.CartView, problem.ApiError] { lift(s.add_line(i.path_int("id")?, b.product_id, b.qty)) }))

    let mut set = openapi.op("PUT", r"/api/carts/{id}/lines/{product_id}").operation_id("setLine").summary("Set a line's quantity (0 removes it)").tag("cart")
    set = set.path_param("id", id).path_param("product_id", id).max_body(1024).body(QtyIn.json_schema().describe("The new quantity; 0 removes the line"), "The quantity")
    set = set.returns(200, "The cart", cart_ref).fails(404, "No such cart or product").fails(409, "Not enough stock").fails(422, "Too many products")
    svc.add(set, openapi.json_body_with(|i: openapi.Input, b: QtyIn| -> Result[store.CartView, problem.ApiError] { lift(s.set_line(i.path_int("id")?, i.path_int("product_id")?, b.qty)) }))

    let mut rm = openapi.op("DELETE", r"/api/carts/{id}/lines/{product_id}").operation_id("removeLine").summary("Remove a product from a cart").tag("cart")
    rm = rm.path_param("id", id).path_param("product_id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart, or the product is not in it")
    svc.add(rm, openapi.json_out(|i: openapi.Input| -> Result[store.CartView, problem.ApiError] { lift(s.remove_line(i.path_int("id")?, i.path_int("product_id")?)) }))

    let mut cp = openapi.op("PUT", r"/api/carts/{id}/coupon").operation_id("applyCoupon").summary("Apply a coupon").tag("cart")
    cp = cp.path_param("id", id).max_body(1024).body(CodeIn.json_schema().describe("A coupon code (case and surrounding spaces don't matter)"), "The code")
    cp = cp.returns(200, "The cart", cart_ref).fails(404, "No such cart").fails(422, "No such coupon, or the subtotal is below its minimum")
    svc.add(cp, openapi.json_body_with(|i: openapi.Input, b: CodeIn| -> Result[store.CartView, problem.ApiError] { lift(s.set_coupon(i.path_int("id")?, b.code)) }))

    let mut uncp = openapi.op("DELETE", r"/api/carts/{id}/coupon").operation_id("removeCoupon").summary("Remove the coupon").tag("cart")
    uncp = uncp.path_param("id", id).returns(200, "The cart", cart_ref).fails(404, "No such cart")
    svc.add(uncp, openapi.json_out(|i: openapi.Input| -> Result[store.CartView, problem.ApiError] { lift(s.clear_coupon(i.path_int("id")?)) }))

    let mut buy = openapi.op("POST", r"/api/carts/{id}/checkout").operation_id("checkout").summary("Buy a cart").tag("orders")
    buy = buy.describe("Checks the stock of every line, prices the cart with the shared rules, takes the stock and records the order in one critical section; the cart is deleted.")
    buy = buy.path_param("id", id).max_body(2048).body(validate.Customer.json_schema().describe("Who is buying"), "Who is buying")
    buy = buy.returns(201, "The order", order).fails(404, "No such cart").fails(409, "Not enough stock").fails(422, "The cart is empty, or the name or email is not valid")
    svc.add(buy, openapi.json_body_with(|i: openapi.Input, b: validate.Customer| -> Result[OrderBody, problem.ApiError] {
        let placed = lift(s.checkout(i.path_int("id")?, b.name, b.email, now_ns()))?
        Ok(order_body(placed))
    }))

    let mut orders = openapi.op("GET", "/api/orders").operation_id("listOrders").summary("List orders, newest first").tag("orders")
    orders = orders.query("email", email_schema(), "Only this customer's orders")
    orders = orders.returns(200, "The orders", schema.array(order))
    svc.add(orders, openapi.json_out(|i: openapi.Input| -> Result[List[OrderBody], problem.ApiError] { Ok(order_bodies(s.orders(i.query_text("email")))) }))

    let mut one = openapi.op("GET", r"/api/orders/{id}").operation_id("getOrder").summary("Get an order").tag("orders")
    one = one.path_param("id", id).returns(200, "The order", order).fails(404, "No such order")
    svc.add(one, openapi.json_out(|i: openapi.Input| -> Result[OrderBody, problem.ApiError] {
        let found = lift(s.order(i.path_int("id")?))?
        Ok(order_body(found))
    }))

    svc.raw("GET", "/health", |q: http.Request| -> http.Response { http.text(200, "ok") })
    svc
}
