// server: the Eider Shop on 127.0.0.1.
//
//   eider run server/main.ei            (or the binary: target/server [port])
//   server [port]                       default 8080, or $PORT; 0: any free port
//   server --openapi                    print the OpenAPI description and exit
//                                       (web/scripts/gen-api.mjs makes the TypeScript client from it)
//
// Environment:
//   SHOP_WEB_DIR      the built front end to serve (default ../web/dist, then web/dist)
//   SHOP_ADMIN_TOKEN  the bearer token of the JSON-RPC admin API at /rpc (default: a random
//                     one, printed on stderr)
//   SHOP_CORS_ORIGIN  an origin allowed to call the API from a browser (default
//                     http://localhost:5173, the Vite dev server)
//
// One JSON access-log line per request goes to stdout; everything else to stderr. SIGTERM or
// SIGINT shuts it down gracefully: requests in flight finish, then it prints what it
// served. Plain HTTP only: put it behind a TLS-terminating proxy to expose it.

import std.bytes
import std.encoding
import std.env
import std.fd
import std.fs
import std.io
import std.net
import std.random
import std.signal
import std.stream
import std.sync
import std.task
import std.time
import http.server
import http.middleware
import http.metrics
import server.store
import server.app

fn lit(s: str) -> List[u8] { String.from(s).bytes() }

fn say(s: str) uses io { io.errln(lit(s)) }

fn env_or(name: str, fallback: str) -> List[u8] uses io {
    match env.get(lit(name)) {
        Some(v) => {
            if v.len() > 0 { return v }
        }
        None => {}
    }
    lit(fallback)
}

fn port_arg() -> i32 uses io {
    let a = env.args()
    let text = if a.len() >= 2 { a[1].copy() } else { env_or("PORT", "8080") }
    match bytes.parse_u64(text) {
        Some(p) => {
            if p > 65535 {
                say("server: the port is 0 to 65535")
                env.exit(2)
            }
            p as i32
        }
        None => {
            say("usage: server [port | --openapi]")
            env.exit(2)
            0
        }
    }
}

fn admin_token() -> List[u8] uses io {
    let t = env_or("SHOP_ADMIN_TOKEN", "")
    if t.len() > 0 { return t }
    let r = encoding.hex(random.bytes(16).unwrap()).bytes()
    io.errln(bytes.concat(lit("server: SHOP_ADMIN_TOKEN is not set; the admin token is "), r))
    r
}

fn web_root() -> List[u8] uses io, fs {
    let set = env_or("SHOP_WEB_DIR", "")
    if set.len() > 0 { return set }
    for p in ["../web/dist", "web/dist"] {
        if fs.is_dir(lit(p)) { return lit(p) }
    }
    lit("web/dist")
}

fn wall_ns() -> i64 uses clock { time.wall_ns() }

fn main() uses io, fs, net, clock, threads {
    let args = env.args()
    if args.len() >= 2 && bytes.eq(args[1], lit("--openapi")) {
        let no_admin = |t: List[u8]| -> Option[List[u8]] { None }
        let svc = app.routes(store.store(), no_admin, metrics.new(), lit("web/dist"), wall_ns)
        io.outln(svc.document_json())
        return
    }

    let srv = match server.listen(net.ipv4(127, 0, 0, 1, port_arg()), server.config()) {
        Ok(s) => s
        Err(e) => {
            io.errln(e.bytes())
            env.exit(1)
            return
        }
    }
    let mut tokens: List[(List[u8], List[u8])] = List.new()
    tokens.push((admin_token(), lit("admin")))
    let origin = env_or("SHOP_CORS_ORIGIN", "http://localhost:5173")
    let cors = middleware.cors_config()
    let mut cors_ok = cors.copy()
    cors_ok.origins.push(origin)
    let root = web_root()
    let parts = app.Parts(sync.lock(stream.stdout()), metrics.new(), middleware.random_ids().unwrap(), cors_ok, middleware.token_table(tokens), root, wall_ns)
    let h = app.app(store.store(), parts)
    let mut l = lit("server: listening on http://")
    bytes.append(inout l, net.text(srv.addr()))
    bytes.append(inout l, lit(" (web: "))
    bytes.append(inout l, root)
    bytes.append(inout l, lit(")"))
    io.errln(l)

    // TERM and INT arrive on the signal pipe; a thread waits for one and cancels the server
    // TODO(eider-lang#24): std's "cancel a token on SIGTERM/SIGINT" helper replaces this block
    let tok = task.root()
    signal.watch(signal.TERM).unwrap()
    signal.watch(signal.INT).unwrap()
    let sig_fd = signal.events_fd().unwrap()
    let t = tok
    let waiter = spawn(|| -> i32 {
        let mut going = true
        while going {
            match fd.wait_ready(sig_fd, fd.READY_READ, t.deadline()) {
                Ok(true) => {
                    if signal.pending().unwrap_or(List.new()).len() > 0 { going = false }
                }
                Ok(false) => { going = false }
                Err(e) => { going = false }
            }
        }
        t.cancel()
        0
    })
    match srv.serve(h, tok) {
        Ok(st) => {
            let m = "server: stopped after {st.requests} requests on {st.connections} connections"
            io.errln(m.bytes())
        }
        Err(e) => io.errln(e.bytes())
    }
    let z = waiter.join()
}
