// server: the Eider Shop on 127.0.0.1.
//
//   eider run server/main.ei            (or the binary: target/server [--port=8080])
//   server --port=0                     any free port
//   server --openapi                    print the OpenAPI description and exit
//                                       (web/scripts/gen-api.mjs makes the TypeScript client from it)
//
// Settings (std/config: defaults, then the environment, then flags; a flag or variable the
// defaults don't name is an error):
//
//   --port             SHOP_PORT          default 8080; 0: any free port
//   --admin.token      SHOP_ADMIN_TOKEN   the bearer token of the JSON-RPC admin API at /rpc
//                                         (default: a random one, logged at startup)
//   --web.dir          SHOP_WEB_DIR       the built front end to serve (default ../web/dist, then web/dist)
//   --cors.origin      SHOP_CORS_ORIGIN   an origin allowed to call the API from a browser (default
//                                         http://localhost:5173, the Vite dev server)
//
// One JSON access-log line per request and one for its trace span (eider-http) go through
// the service's eider-logging logger, like the startup and shutdown lines, on stderr. SIGTERM or SIGINT shuts it down gracefully (std/service):
// requests in flight finish, then it logs what it served. Plain HTTP only: put it behind a
// TLS-terminating proxy to expose it.

import core.sys
import std.config
import std.encoding
import std.fs
import std.io
import logging
import std.net
import std.random
import std.service
import std.task
import std.time
import std.env
import http.server
import http.middleware
import http.metrics
import http.trace
import server.store
import server.app

type Settings = { port: i64, admin_token: String, web_dir: String, cors_origin: String, openapi: bool }

fn settings() -> Result[Settings, String] uses io {
    let base = config.new().default("port", "8080").default("admin.token", "").default("web.dir", "").default("cors.origin", "http://localhost:5173").default("openapi", "false")
    let c = base.env("SHOP")?.flags(env.args())?
    let port = c.int("port")?
    if port < 0 || port > 65535 { return Err(String.from("config: port must be 0 to 65535")) }
    Ok(Settings(port, c.str("admin.token")?, c.str("web.dir")?, c.str("cors.origin")?, c.bool("openapi")?))
}

fn web_root(set: String) -> List[u8] uses fs {
    if set.len() > 0 { return set.bytes() }
    for p in ["../web/dist", "web/dist"] {
        if fs.is_dir(p.bytes()) { return p.bytes() }
    }
    "web/dist".bytes()
}

fn wall_ns() -> i64 uses clock { time.wall_ns() }

fn main() -> Result[(), String] uses io, fs, net, clock, threads {
    let cfg = settings()?
    if cfg.openapi {
        let no_admin = |t: List[u8]| -> Option[List[u8]] { None }
        let svc = app.routes(store.store(), no_admin, metrics.new(), "web/dist".bytes(), wall_ns)
        io.outln(svc.document_json())
        return Ok(())
    }
    let lg = logging.new(logging.Info).with(logging.fields().text("service", String.from("shop")))

    let srv = server.listen(net.ipv4(127, 0, 0, 1, cfg.port as i32), server.config())?
    let mut token = cfg.admin_token.copy()
    if token.len() == 0 {
        token = encoding.hex(random.bytes(16).unwrap())
        lg.warn("SHOP_ADMIN_TOKEN is not set; using a random admin token", logging.fields().text("admin_token", token.copy()))
    }
    let mut tokens: List[(List[u8], List[u8])] = List.new()
    tokens.push((token.bytes(), "admin".bytes()))
    let cors = middleware.cors_config()
    let mut cors_ok = cors.copy()
    cors_ok.origins.push(cfg.cors_origin.bytes())
    let root = web_root(cfg.web_dir.copy())
    let parts = app.Parts(lg, trace.tracer(trace.log_sink(lg)), metrics.by_route(metrics.new()), middleware.random_ids().unwrap(), cors_ok, middleware.token_table(tokens), root, wall_ns)
    let h = app.app(store.store(), parts)
    let addr = sys.to_string(net.text(srv.addr()))
    lg.info("listening", logging.fields().text("addr", addr).text("web", sys.to_string(root.copy())))

    // SIGTERM or SIGINT cancels the root token; the server drains and returns
    let tok = task.root()
    let watcher = service.cancel_on_term(tok)?
    let st = srv.serve(h, tok)?
    let signal = watcher.join()
    lg.info("stopped", logging.fields().uint("requests", st.requests as u64).uint("connections", st.connections as u64).int("signal", signal as i64))
    Ok(())
}
