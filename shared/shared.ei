//! shared: the shop's domain logic, used by the server (native) and the web front end
//! (WebAssembly, through ../shared-wasm), so both compute the same totals and refuse the
//! same input with the same messages.
//!
//! | Module | What |
//! |---|---|
//! | `shared` (this file) | `ShopError`, its stable codes and messages |
//! | `shared.money` | `Money` in integer cents with checked arithmetic |
//! | `shared.coupon` | the coupon table and what a coupon takes off |
//! | `shared.cart` | cart items (product and quantity), priced lines, the `Quote` |
//! | `shared.validate` | quantities, stock, customer name and email |
//!
//! The package is pure: no function in it declares a capability, so its eider.toml grant
//! in the server is empty, and the compiler holds it to that (E0204). The WebAssembly
//! module is the package ../shared-wasm.

import shared.money

/// Everything the shop can refuse. Each variant has a stable code (`code`), which is how an
/// error crosses the WebAssembly boundary in the integer exports (the text exports carry it in JSON).
pub type ShopError =
    | AmountTooLarge
    | QtyOutOfRange(min: i64, max: i64)
    | OutOfStock(product_id: i64, wanted: i64, have: i64)
    | UnknownProduct(product_id: i64)
    | TooManyLines(max: i64)
    | UnknownCoupon(code: String)
    | CouponMinimum(code: String, min_cents: i64)
    | EmptyCart
    | InvalidName
    | InvalidEmail
    | NotInCart(product_id: i64)
    | BadInput(what: String)

// `?` on a money result gives a ShopError
impl From[money.MoneyError] for ShopError {
    fn from(value: money.MoneyError) -> ShopError { AmountTooLarge }
}

/// The error's stable code (1 to 12); the TypeScript side switches on it.
pub fn code(e: ShopError) -> i32 {
    match e {
        AmountTooLarge => 1
        QtyOutOfRange { .. } => 2
        OutOfStock { .. } => 3
        UnknownProduct { .. } => 4
        TooManyLines { .. } => 5
        UnknownCoupon { .. } => 6
        CouponMinimum { .. } => 7
        EmptyCart => 8
        InvalidName => 9
        InvalidEmail => 10
        NotInCart { .. } => 11
        BadInput { .. } => 12
    }
}

/// The field a request error is about, for problem+json and form errors.
pub fn field(e: ShopError) -> String {
    match e {
        QtyOutOfRange { .. } | OutOfStock { .. } => String.from("qty")
        UnknownProduct { .. } | NotInCart { .. } => String.from("product_id")
        UnknownCoupon { .. } | CouponMinimum { .. } => String.from("code")
        InvalidName => String.from("name")
        InvalidEmail => String.from("email")
        _ => String.from("")
    }
}

/// What went wrong, for people. The server's problem+json `detail` and the web page show
/// this same text.
pub fn message(e: ShopError) -> String {
    match e {
        AmountTooLarge => String.from("the amount is too large")
        QtyOutOfRange(min, max) => "the quantity must be {min} to {max}"
        OutOfStock(p, wanted, have) => "only {have} of product {p} in stock (wanted {wanted})"
        UnknownProduct(p) => "there is no product {p}"
        TooManyLines(max) => "a cart holds at most {max} different products"
        UnknownCoupon(c) => "there is no coupon {c}"
        CouponMinimum(c, min) => {
            let least = money.format(money.Money(min))
            "coupon {c} needs a subtotal of at least {least}"
        }
        EmptyCart => String.from("the cart is empty")
        InvalidName => String.from("the name must be 1 to 80 characters")
        InvalidEmail => String.from("the email address is not valid")
        NotInCart(p) => "product {p} is not in the cart"
        BadInput(w) => "bad input: {w}"
    }
}

/// The HTTP status the server answers an error with.
pub fn status(e: ShopError) -> i32 {
    match e {
        UnknownProduct { .. } | NotInCart { .. } => 404
        OutOfStock { .. } => 409
        BadInput { .. } => 400
        _ => 422
    }
}
