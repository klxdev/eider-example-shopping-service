//! shared/validate: the checks on what a shopper types, shared by the server (which
//! enforces them) and the web page (which shows them before a request is sent).

import std.serial
import std.strings
import std.validate as sv
import json
import shared

/// A line's quantity is 1 to MAX_QTY.
pub const MAX_QTY: i64 = 10

/// A cart holds at most MAX_LINES different products.
pub const MAX_LINES: i64 = 20

/// A name is 1 to MAX_NAME characters after trimming.
pub const MAX_NAME: i64 = 80

/// The longest email address (RFC 5321's path limit).
pub const MAX_EMAIL: i64 = 254

/// A quantity for a cart line.
pub fn qty(q: i64) -> Result[i64, shared.ShopError] {
    if q < 1 || q > MAX_QTY { return Err(shared.QtyOutOfRange(1, MAX_QTY)) }
    Ok(q)
}

/// `wanted` of product `id` when `have` are in stock.
pub fn stock(id: i64, wanted: i64, have: i64) -> Result[i64, shared.ShopError] {
    if wanted > have { return Err(shared.OutOfStock(id, wanted, have)) }
    Ok(wanted)
}

/// A customer's name, trimmed: 1 to MAX_NAME characters, no control characters.
pub fn name(n: String) -> Result[String, shared.ShopError] {
    let t = strings.trim(n)
    let count = strings.char_count(t.copy())
    if count == 0 || count as i64 > MAX_NAME { return Err(shared.InvalidName) }
    for b in t.bytes() {
        if b < 32 || b == 127 { return Err(shared.InvalidName) }
    }
    Ok(t)
}

/// An email address, trimmed and with its domain in lower case; the syntax is
/// `std/validate`'s `email` (the same rule `@[check(format = "email")]` applies to a request).
pub fn email(e: String) -> Result[String, shared.ShopError] {
    let t = strings.trim(e)
    if !sv.email(t.bytes()) { return Err(shared.InvalidEmail) }
    match strings.split_once(t, "@") {
        Some(parts) => Ok("{parts.0}@{strings.to_lower(parts.1.copy())}")
        None => Err(shared.InvalidEmail)
    }
}

/// A customer at checkout.
@[derive(Serialize, Deserialize)]
pub type Customer = {
    @[check(min_len = 1, max_len = MAX_NAME)] name: String
    @[check(format = "email", min_len = 3, max_len = MAX_EMAIL)] email: String
}

/// The customer, or every field that is wrong (for a form that marks each one).
pub fn customer(n: String, e: String) -> Result[Customer, List[shared.ShopError]] {
    let mut errs: List[shared.ShopError] = List.new()
    let nn = name(n)
    let ee = email(e)
    match nn {
        Err(x) => errs.push(x)
        Ok(v) => {}
    }
    match ee {
        Err(x) => errs.push(x)
        Ok(v) => {}
    }
    if errs.len() > 0 { return Err(errs) }
    Ok(Customer(nn.unwrap(), ee.unwrap()))
}
