// cart, coupon and validate: the rules both sides share.
import std.testing
import shared
import shared.money
import shared.cart
import shared.coupon
import shared.validate


fn m(c: i64) -> money.Money { money.of(c).unwrap() }

fn line(id: i64, unit: i64, qty: i64) -> cart.Line { cart.Line(id, m(unit), qty) }

test "add merges lines and checks quantity and stock" {
    let mut items: List[cart.Item] = List.new()
    assert cart.add(inout items, 1, 2, 5) == Ok(2)
    assert cart.add(inout items, 1, 3, 5) == Ok(5)
    assert items.len() == 1
    // a failed add leaves the cart as it was
    assert cart.add(inout items, 1, 1, 5) == Err(shared.OutOfStock(1, 6, 5))
    assert items[0].qty == 5
    assert cart.add(inout items, 2, 0, 5) == Err(shared.QtyOutOfRange(1, 10))
    assert cart.add(inout items, 2, 11, 50) == Err(shared.QtyOutOfRange(1, 10))
    assert items.len() == 1
}

test "a cart holds at most MAX_LINES products" {
    let mut items: List[cart.Item] = List.new()
    for i in 0..validate.MAX_LINES { assert cart.add(inout items, i + 1, 1, 9).is_ok() }
    assert cart.add(inout items, 99, 1, 9) == Err(shared.TooManyLines(20))
    assert cart.add(inout items, 1, 1, 9) == Ok(2)
}

test "set and remove" {
    let mut items: List[cart.Item] = List.new()
    assert cart.set(inout items, 7, 4, 10) == Ok(4)
    assert cart.set(inout items, 7, 2, 10) == Ok(2)
    assert items[0].qty == 2
    assert cart.set(inout items, 7, 3, 2) == Err(shared.OutOfStock(7, 3, 2))
    assert cart.remove(inout items, 8) == Err(shared.NotInCart(8))
    assert cart.set(inout items, 7, 0, 10) == Ok(0)
    assert items.len() == 0
}

test "quote without a coupon" {
    let mut lines: List[cart.Line] = List.new()
    lines.push(line(1, 1299, 2))
    lines.push(line(2, 450, 1))
    let q = cart.quote(lines, None).unwrap()
    assert q.subtotal == m(3048)
    assert q.discount == m(0)
    assert q.shipping == m(599)
    assert q.tax == m(251)          // 8.25% of 30.48 = 2.5146
    assert q.total == m(3898)
    assert !q.coupon_applied
}

test "an empty cart costs nothing" {
    let lines: List[cart.Line] = List.new()
    let q = cart.quote(lines, None).unwrap()
    assert q.total == m(0)
    assert q.shipping == m(0)
}

test "free shipping from $50 after discounts" {
    let mut lines: List[cart.Line] = List.new()
    lines.push(line(1, 5000, 1))
    assert cart.quote(lines, None).unwrap().shipping == m(0)
    // SAVE10 brings it under $50, so shipping is charged again
    let q = cart.quote(lines, coupon.find(String.from("save10")).ok()).unwrap()
    assert q.discount == m(500)
    assert q.shipping == m(599)
    assert q.tax == m(371)          // 8.25% of 45.00 = 3.7125
    assert q.total == m(5470)
}

test "coupons" {
    let mut lines: List[cart.Line] = List.new()
    lines.push(line(1, 1000, 2))
    let take5 = coupon.find(String.from(" take5 ")).unwrap()
    assert take5.id == 2
    // under TAKE5's $25 minimum: not applied
    let q = cart.quote(lines, Some(take5.copy())).unwrap()
    assert !q.coupon_applied
    assert q.discount == m(0)
    lines.push(line(2, 1000, 1))
    let q2 = cart.quote(lines, Some(take5)).unwrap()
    assert q2.coupon_applied
    assert q2.discount == m(500)
    let fs = cart.quote(lines, coupon.by_id(3)).unwrap()
    assert fs.shipping == m(0) && fs.discount == m(0) && fs.coupon_applied
    assert coupon.find(String.from("NOPE")) == Err(shared.UnknownCoupon(String.from("NOPE")))
    testing.assert_eq(coupon.describe(coupon.by_id(2).unwrap()), String.from("$5.00 off orders of $25.00 or more"))
    testing.assert_eq(coupon.describe(coupon.by_id(1).unwrap()), String.from("10% off"))
}

test "a quote that overflows is an error, not a trap" {
    let mut lines: List[cart.Line] = List.new()
    lines.push(line(1, money.MAX_CENTS, 1))
    lines.push(line(2, 1, 1))
    assert cart.quote(lines, None) == Err(shared.AmountTooLarge)
}

test "names" {
    assert validate.name(String.from("  Ada Lovelace ")) == Ok(String.from("Ada Lovelace"))
    assert validate.name(String.from("   ")) == Err(shared.InvalidName)
    assert validate.name(strings_of(81)) == Err(shared.InvalidName)
    assert validate.name(strings_of(80)).is_ok()
}

fn strings_of(n: i64) -> String {
    let mut s = String.from("")
    for i in 0..n { s.push_str("é") }
    s
}

test "emails" {
    assert validate.email(String.from(" ada@Example.COM ")) == Ok(String.from("ada@example.com"))
    assert validate.email(String.from("a.b+tag@mail.example.org")).is_ok()
    // TODO(eider-lang#47): name the address in the message once assert takes a computed one
    for bad in ["", "ada", "ada@", "@example.com", "ada@example", "ada@@example.com", "a da@example.com", "ada@-x.com", "ada@ex_ample.com", "ada@example..com"] {
        assert validate.email(String.from(bad)) == Err(shared.InvalidEmail), "a bad email was accepted"
    }
}

test "customer collects every field error" {
    match validate.customer(String.from(""), String.from("nope")) {
        Ok(c) => assert false
        Err(es) => {
            assert es.len() == 2
            assert shared.field(es[0]) == String.from("name")
            assert shared.field(es[1]) == String.from("email")
        }
    }
    assert validate.customer(String.from("Ada"), String.from("ada@example.com")).is_ok()
}

test "errors have stable codes and messages" {
    assert shared.code(shared.OutOfStock(3, 5, 2)) == 3
    testing.assert_eq(shared.message(shared.OutOfStock(3, 5, 2)), String.from("only 2 of product 3 in stock (wanted 5)"))
    testing.assert_eq(shared.message(shared.CouponMinimum(String.from("TAKE5"), 2500)), String.from("coupon TAKE5 needs a subtotal of at least $25.00"))
    assert shared.status(shared.OutOfStock(3, 5, 2)) == 409
    assert shared.status(shared.InvalidEmail) == 422
}
